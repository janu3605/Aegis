# Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# Firebase Configuration (Optional - for community feed & real-time DB)
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key-here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id

# Google Gemini AI API Key (for chatbot)
# Get your API key from: https://makersuite.google.com/app/apikey
EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-api-key-here

# Google Speech-to-Text API Key (for voice "help help help" detection)
# Get your API key from: https://console.cloud.google.com/apis/credentials
EXPO_PUBLIC_GOOGLE_SPEECH_API_KEY=your-speech-api-key-here

# Vercel Serverless Function Configuration (for automatic SMS)
# Deploy to Vercel, then add your URL here
# Example: https://aegis-app.vercel.app/api/sendSOS
EXPO_PUBLIC_VERCEL_ENDPOINT=https://your-vercel-app.vercel.app/api/sendSOS

# SOS Auth Token (secure token to authenticate SOS requests)
# Generate a random secure token and keep it secret
EXPO_PUBLIC_SOS_AUTH_TOKEN=your-secure-token-here

# App Configuration
EXPO_PUBLIC_APP_ENV=development
